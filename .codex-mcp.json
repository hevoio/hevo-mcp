{
  "mcpServers": {
    "hevo": {
      "command": "uvx",
      "args": [
        "--from",
        "hevo-mcp==1.0.1",
        "-c",
        "https://raw.githubusercontent.com/hevoio/hevo-mcp/v1.0.1/constraints.txt",
        "--python",
        "3.12",
        "hevo-mcp"
      ],
      "env_vars": [
        "HEVO_KEYS_DIR",
        "HEVO_MCP_DEFAULT_SCOPE",
        "HOME"
      ]
    }
  }
}
