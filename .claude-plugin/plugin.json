{
  "name": "hevo-data",
  "version": "1.0.0",
  "description": "Connects your AI agent to Hevo. Includes the hevo-pipelines skill and the Hevo MCP server, which manages your Pipelines, Destinations, Models, Workflows, team users, and OAuth accounts through the Hevo API.",
  "author": {
    "name": "Hevo Data",
    "url": "https://hevodata.com"
  },
  "homepage": "https://hevodata.com",
  "repository": "https://github.com/hevoio/hevo-mcp",
  "license": "MIT",
  "keywords": [
    "hevo",
    "data-pipelines",
    "etl",
    "elt",
    "mcp",
    "edge"
  ],
  "mcpServers": {
    "hevo": {
      "command": "uvx",
      "args": [
        "--from",
        "${CLAUDE_PLUGIN_ROOT}",
        "-c",
        "${CLAUDE_PLUGIN_ROOT}/constraints.txt",
        "--python",
        "3.12",
        "hevo-mcp"
      ],
      "env": {
        "HEVO_MCP_DEFAULT_SCOPE": "${HEVO_MCP_DEFAULT_SCOPE:-read}",
        "HEVO_KEYS_DIR": "${HEVO_KEYS_DIR:-}"
      }
    }
  }
}
